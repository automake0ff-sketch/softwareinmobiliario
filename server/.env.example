# ── Puerto ──
PORT=3002

# ── URL de la app (para enlaces en emails/webhooks) ──
APP_URL=https://TU_FRONTEND.vercel.app

# ── OpenRouter (necesario para Agentes IA) ──
OPENROUTER_API_KEY=sk-or-v1-TU_API_KEY_AQUI
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_FAST_MODEL=openai/gpt-4o-mini
AGENT_SMART_MODEL=openai/gpt-4o
AGENT_REASON_MODEL=anthropic/claude-opus-4-5

# ── Stripe (opcional, para suscripciones) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal (opcional) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── WhatsApp / Meta (opcional) ──
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_WEBHOOK_SECRET=

# ── Twilio (opcional, para llamadas) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email (opcional) ──
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Google Calendar (opcional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://TU_BACKEND.railway.app/api/calendar/callback

# ── API Token para webhooks ──
API_TOKEN=
