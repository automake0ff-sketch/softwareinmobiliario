# ══════════════════════════════════════════════════════
# softwareinmobiliario — variables de entorno de ejemplo
# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitees el .env real al repositorio.
# ══════════════════════════════════════════════════════

# ── Supabase (CRÍTICO) ──
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# ── API (backend Express en Railway) ──
# En desarrollo: déjalo como /api (proxy de Vite lo redirige a localhost:3002)
# En producción en Vercel: pon la URL completa de tu Railway backend
VITE_API_URL=/api

# ── Server ──
DATABASE_URL=postgresql://postgres:PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=TU_JWT_SECRET_DE_SUPABASE_DASHBOARD_SETTINGS_API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
PORT=3002
NODE_ENV=development
APP_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:5173

# ── OpenRouter (agentes IA) ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_FAST_MODEL=openai/gpt-4o-mini
AGENT_SMART_MODEL=openai/gpt-4o
AGENT_REASON_MODEL=anthropic/claude-opus-4-5

# ── Stripe (opcional) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal (opcional) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── WhatsApp / Meta (opcional) ──
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_WEBHOOK_SECRET=

# ── Email (opcional) ──
SENDGRID_API_KEY=
FROM_EMAIL=noreply@tudominio.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Twilio (opcional) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Google Calendar (opcional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://TU_BACKEND.up.railway.app/api/calendar/callback
