import { createMiddlewareClient } from '@supabase/auth-helpers-nextjs'
import { NextResponse } from 'next/server'
import type { NextRequest } from 'next/server'

// Rutas estrictamente públicas (no requieren sesión)
const publicRoutes = ['/login', '/register', '/pricing', '/api/auth/callback']

// Rutas de configuración (requieren sesión, pero no deben redirigir al dashboard)
const setupRoutes = ['/onboarding']

export async function middleware(req: NextRequest) {
  const res = NextResponse.next()
  const supabase = createMiddlewareClient({ req, res })
  const { data: { session } } = await supabase.auth.getSession()

  const { pathname } = req.nextUrl

  const isPublicRoute = publicRoutes.some(route => pathname.startsWith(route))
  const isSetupRoute = setupRoutes.some(route => pathname.startsWith(route))
  const isApiRoute = pathname.startsWith('/api/')
  const isStaticFile = pathname.startsWith('/_next/') || pathname.startsWith('/favicon')

  if (isStaticFile) return res

  if (isApiRoute) {
    // Nota: Si la API usa Clerk o JWT propio, esta validación de Supabase fallará.
    if (!session) {
      // Permitir rutas de API públicas si es necesario, o manejar la auth en el endpoint
      // return NextResponse.json({ error: 'No autenticado' }, { status: 401 })
    }
    return res
  }

  // 1. Si NO hay sesión y NO es una ruta pública, redirigir al login
  // Excepción: Si usan Clerk para el onboarding, Supabase no verá la sesión.
  // Si el onboarding es manejado por Clerk, deberíamos permitir el paso o usar el middleware de Clerk.
  if (!session && !isPublicRoute && !isSetupRoute) {
    const loginUrl = new URL('/login', req.url)
    loginUrl.searchParams.set('redirect', pathname)
    return NextResponse.redirect(loginUrl)
  }

  // 2. Si HAY sesión y es una ruta pública, redirigir al dashboard
  if (session && isPublicRoute) {
    return NextResponse.redirect(new URL('/dashboard', req.url))
  }

  // 3. Si HAY sesión y está en /onboarding, permitir el paso (no redirigir a dashboard)
  if (session && isSetupRoute) {
    return res
  }

  return res
}

export const config = {
  matcher: [
    '/((?!_next/static|_next/image|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$).*)',
  ],
}
