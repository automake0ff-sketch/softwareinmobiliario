# ── 🔑 OpenRouter (necesario para Agentes IA y RAG) ──
VITE_OPENROUTER_API_KEY=REEMPLAZA_CON_TU_OPENROUTER_KEY
OPENROUTER_API_KEY=REEMPLAZA_CON_TU_OPENROUTER_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_FAST_MODEL=openai/gpt-4o-mini
AGENT_SMART_MODEL=openai/gpt-4o
AGENT_REASON_MODEL=anthropic/claude-opus-4-5

# ── 💳 Stripe (producción) ──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── 💳 PayPal (opcional) ──
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...

# ── 📱 WhatsApp / Meta (opcional) ──
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_WEBHOOK_SECRET=

# ── 📧 Email (opcional) ──
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── 📍 URL de la app ──
# En desarrollo:
APP_URL=http://localhost:3002
VITE_API_URL=/api
PORT=3002

# ── 🚀 NUEVO: SERVIDOR ÚNICO (recomendado) ──
# ═══════════════════════════════════════════════════════════
# El servidor Express ahora sirve TANTO la API como el frontend.
# Solo necesitas UN despliegue para todo el software.
#
# LOCAL:
#   1. Ejecuta: npm start (construye frontend + inicia servidor)
#   2. O haz doble clic en start.cmd
#   3. Abre http://localhost:3002
#
# VPS GRATIS (Fly.io, Oracle Cloud Always Free, etc):
#   1. Sube el código a un VPS
#   2. Ejecuta: npm run build && node server/index.js
#   3. Abre http://TU_IP:3002
#
# Fly.io (gratuito):
#   1. Instala flyctl: https://fly.io/docs/hands-on/install/
#   2. fly launch --name tunombre-crm
#   3. fly deploy
#   4. fly open
#
# ═══════════════════════════════════════════════════════════
# OPCIÓN: Frontend en Vercel + Backend separado
# ═══════════════════════════════════════════════════════════
# Si prefieres mantener frontend en Vercel y backend en Railway:
#   - Vercel: VITE_API_URL = https://TU_BACKEND.up.railway.app
#   - Railway: usa server/railway.json (config incluida)
#
# ═══════════════════════════════════════════════════════════
# BASE DE DATOS
# ═══════════════════════════════════════════════════════════
# - SQLite se guarda en ./data/crm.db
# - Para VPS: monta un volumen persistente en /data/
# - Para producción con múltiples réplicas: migrar a PostgreSQL
