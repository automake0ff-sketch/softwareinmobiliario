# ════════════════════════════════════════════════════════
# Base de datos — CRÍTICO
# ════════════════════════════════════════════════════════
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres
# Tamaño del pool de conexiones de pg (opcional, default 10)
PG_POOL_MAX=10

# ════════════════════════════════════════════════════════
# Auth Supabase — CRÍTICO
# Supabase Dashboard → Settings → API → JWT Secret
# ════════════════════════════════════════════════════════
SUPABASE_JWT_SECRET=REEMPLAZA_CON_TU_JWT_SECRET_DE_SUPABASE
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZA_CON_TU_SERVICE_ROLE_KEY

# Compatibilidad temporal con JWTs propios emitidos antes de esta migración.
# Si ya no hay tokens viejos en circulación, déjalo vacío y elimina el fallback en auth.js.
JWT_SECRET=

# ── Puerto y entorno ──
PORT=3002
NODE_ENV=production

# ── URL de la app (para enlaces en emails/webhooks) ──
APP_URL=https://TU_FRONTEND.vercel.app
ALLOWED_ORIGINS=https://TU_FRONTEND.vercel.app

# ── Nombre por defecto al aprovisionar una agencia nueva (opcional) ──
AGENCY_NAME=Mi Inmobiliaria

# ── OpenRouter (necesario para Agentes IA) ──
OPENROUTER_API_KEY=REEMPLAZA_CON_TU_OPENROUTER_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_FAST_MODEL=openai/gpt-4o-mini
AGENT_SMART_MODEL=openai/gpt-4o
AGENT_REASON_MODEL=anthropic/claude-opus-4-5

# ── Anthropic (usado directamente en algunos servicios) ──
ANTHROPIC_API_KEY=

# ── Stripe (opcional, para suscripciones) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── PayPal (opcional) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── WhatsApp / Meta (opcional) ──
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Twilio (opcional, para llamadas) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email (opcional) ──
SENDGRID_API_KEY=
FROM_EMAIL=noreplies@tudominio.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Google Calendar (opcional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://TU_BACKEND.fly.dev/api/calendar/callback

# ── API Token legacy para webhooks/dev (opcional) ──
API_TOKEN=
