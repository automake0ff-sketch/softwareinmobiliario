# ── 🔑 OpenRouter (necesario para Agentes IA y RAG) ──
VITE_OPENROUTER_API_KEY=sk-or-v1-TU_API_KEY_AQUI
OPENROUTER_API_KEY=sk-or-v1-TU_API_KEY_AQUI
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_FAST_MODEL=openai/gpt-4o-mini
AGENT_SMART_MODEL=openai/gpt-4o
AGENT_REASON_MODEL=anthropic/claude-opus-4-5

# ── 💳 Stripe (producción) ──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── 💳 PayPal (opcional) ──
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...

# ── 📱 WhatsApp / Meta (opcional) ──
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_WEBHOOK_SECRET=

# ── 📧 Email (opcional) ──
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── 📍 URL de la app ──
# En desarrollo:
APP_URL=http://localhost:5173
VITE_API_URL=/api
PORT=3002

# ── 🚀 DESPLIEGUE EN PRODUCCIÓN ──
# ═══════════════════════════════════════════════════════════
# FRONTEND (Vercel)
# ═══════════════════════════════════════════════════════════
# 1. Ve a https://vercel.com y conecta tu repositorio de GitHub
# 2. En Vercel -> Settings -> Environment Variables, añade:
#    VITE_API_URL = https://TU_BACKEND.railway.app
#    VITE_OPENROUTER_API_KEY = sk-or-v1-...
# 3. Vercel detectará automáticamente Vite y construirá el frontend
#    Importante: en el dashboard de Vercel NO se cambia nada más
#
# ═══════════════════════════════════════════════════════════
# BACKEND (Railway.app — recomendado)
# ═══════════════════════════════════════════════════════════
# 1. Ve a https://railway.app y crea un nuevo proyecto
# 2. Conecta el mismo repositorio de GitHub
# 3. Configura:
#    - Root Directory: server/
#    - Start Command: node index.js
#    - Healthcheck: /api/health
# 4. Añade un Volume persistente montado en /data/ para SQLite:
#    - Railway Dashboard -> Volumes -> Add Volume
#    - Mount Path: /data
#    - Esto hace que la base de datos NO se borre al redeploy
# 5. Añade las Environment Variables desde server/.env.example
#    (al menos OPENROUTER_API_KEY y APP_URL)
# 6. Railway te dará una URL como https://tuservidor.up.railway.app
# 7. COPIA ESA URL y pégala en Vercel como VITE_API_URL (con /api al final)
#    Ejemplo: VITE_API_URL = https://tuservidor.up.railway.app/api
#    También actualiza APP_URL en Railway con la URL de Vercel
#
# ═══════════════════════════════════════════════════════════
# BACKEND (Render — alternativa)
# ═══════════════════════════════════════════════════════════
# 1. Ve a https://render.com y crea un Web Service
# 2. Conecta el repositorio, configura:
#    - Root Directory: server
#    - Build Command: npm install
#    - Start Command: node index.js
# 3. Añade Disco persistente:
#    - Render Dashboard -> Disks -> Add Disk
#    - Mount Path: /data
# 4. Añade las Environment Variables necesarias
# 5. Render dará una URL como https://tuservidor.onrender.com
#
# ═══════════════════════════════════════════════════════════
# BASE DE DATOS
# ═══════════════════════════════════════════════════════════
# - SQLite se guarda en ./data/crm.db (local) o /data/crm.db (Railway/Render)
# - El volumen persistente evita que se borren los datos al redeploy
# - Para producción con múltiples réplicas: migrar a PostgreSQL
