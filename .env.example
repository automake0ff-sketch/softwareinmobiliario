# ── 🔑 OpenRouter (necesario para Agentes IA y RAG) ──
VITE_OPENROUTER_API_KEY=sk-or-v1-TU_API_KEY_AQUI
OPENROUTER_API_KEY=sk-or-v1-TU_API_KEY_AQUI
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_FAST_MODEL=openai/gpt-4o-mini
AGENT_SMART_MODEL=openai/gpt-4o
AGENT_REASON_MODEL=anthropic/claude-opus-4-5

# ── 💳 Stripe (producción) ──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── 💳 PayPal (opcional) ──
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...

# ── 📱 WhatsApp / Meta (opcional) ──
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_WEBHOOK_SECRET=

# ── 📧 Email (opcional) ──
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── 📍 URL de la app ──
# En desarrollo:
APP_URL=http://localhost:5173
VITE_API_URL=/api
PORT=3002

# ── 🚀 DESPLIEGUE EN PRODUCCIÓN ──
# 1. Frontend (Vercel):
#    - Conecta tu repo a https://vercel.com
#    - Añade VITE_API_URL=https://tu-backend.railway.app/api como env var
#    - Vercel build automática
#
# 2. Backend (Railway / Render / Fly.io):
#    - Crea un servicio Node.js con: node server/index.js
#    - Define las env vars de arriba (OPENROUTER_API_KEY, etc.)
#    - Expone el puerto 3002
#
# 3. Base de datos:
#    - SQLite se guarda en ./data/ (incluirlo en persistencia del hosting)
#    - Para alta disponibilidad: migrar a PostgreSQL con pgvector
